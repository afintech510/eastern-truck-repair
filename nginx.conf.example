# Add to your existing nginx (sites-available/easterntruckrepair.com).
# Cloudflare is proxied + SSL on; this is the origin server block.
server {
    listen 80;
    server_name easterntruckrepair.com www.easterntruckrepair.com;

    # If terminating SSL at origin too, add your 443 block / certbot lines here.
    # Since Cloudflare is proxied with SSL, "Full" mode + origin cert is recommended.

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
