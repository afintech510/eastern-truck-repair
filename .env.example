# SMTP transport for lead emails (server-side only — never NEXT_PUBLIC_).
# Works with any mailbox/provider: Gmail/Workspace SMTP, a domain mailbox, or a
# transactional SMTP host. If any required var is unset, /api/lead returns 500
# "email not configured" and the forms show the bilingual call-us error.
# Real values live ONLY in the VPS .env (gitignored) — never commit secrets here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_FROM="Eastern Website <no-reply@easterntruckrepair.com>"
LEAD_TO=            # comma-separated primary recipients, e.g. adam@example.com
LEAD_CC=            # comma-separated CC recipients (optional), e.g. info@easterntruckrepair.com

# Twilio SMS lead notifications (optional — fire-and-forget alongside email).
# If any var is unset, SMS is silently skipped. Email always sends first.
TWILIO_SID=          # Account SID from twilio.com/console
TWILIO_AUTH=         # Auth Token
TWILIO_FROM=         # Your Twilio phone number, e.g. +18885551234
SMS_TO=              # Comma-separated recipient numbers, e.g. +16319391397
TWILIO_WEBHOOK_URL=  # optional — inbound SMS webhook URL for signature validation
                     # defaults to https://www.easterntruckrepair.com/api/sms

# AI Chatbot (server-side — powers the chat widget and SMS auto-responder).
# Get an API key at aistudio.google.com. If unset, /api/chat returns 500
# "chat not configured" and the widget is non-functional.
GEMINI_API_KEY=
CHATBOT_MODEL=       # optional — defaults to gemini-2.0-flash

# Google Analytics 4 (client-side — NEXT_PUBLIC_ prefix required).
# Leave blank to disable tracking. Create a GA4 property at analytics.google.com,
# then paste the Measurement ID here.
NEXT_PUBLIC_GA_ID=   # e.g. G-XXXXXXXXXX
