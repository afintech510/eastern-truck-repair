# SMTP transport for lead emails (server-side only — never NEXT_PUBLIC_).
# Works with any mailbox/provider: Gmail/Workspace SMTP, a domain mailbox, or a
# transactional SMTP host. If any required var is unset, /api/lead returns 500
# "email not configured" and the forms show the bilingual call-us error.
# Real values live ONLY in the VPS .env (gitignored) — never commit secrets here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_FROM="Eastern Website <no-reply@easterntruckrepair.com>"
LEAD_TO=            # comma-separated recipients, e.g. desk@easterntruckrepair.com,carlos@example.com
